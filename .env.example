# ======================
# ISLAMIC DATING APP - Environment Variables
# ======================
# Copy this file to .env and fill in your values

# ======================
# Server Configuration
# ======================
NODE_ENV=development
PORT=5000

# ======================
# Database
# ======================
MONGO_URI=mongodb://localhost:27017/islamic-dating-app
# For MongoDB Atlas:
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/islamic-dating-app?retryWrites=true&w=majority

# ======================
# Security & Authentication
# ======================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d

# Cron job secret for automated tasks
CRON_SECRET=your-cron-secret-key-change-this

# ======================
# Stripe Payment Processing
# ======================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ======================
# Pusher Real-Time Notifications
# ======================
PUSHER_APP_ID=your_pusher_app_id
PUSHER_KEY=your_pusher_key
PUSHER_SECRET=your_pusher_secret
PUSHER_CLUSTER=your_pusher_cluster
# Example: us2, eu, ap1, etc.

# ======================
# Cloudinary Image Hosting
# ======================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ======================
# Email Service (Nodemailer)
# ======================
EMAIL_SERVICE=gmail
# Or: SendGrid, Mailgun, AWS SES, etc.

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
# Set to true for port 465, false for other ports

EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM=noreply@islamicdating.com
EMAIL_FROM_NAME=Islamic Dating App

# For SendGrid:
# SENDGRID_API_KEY=your_sendgrid_api_key

# ======================
# Frontend Configuration
# ======================
CLIENT_URL=http://localhost:3000
# Production: https://yourapp.com

# ======================
# Redis (Optional - for caching/sessions)
# ======================
REDIS_URL=redis://localhost:6379
# For Redis Cloud:
# REDIS_URL=redis://username:password@host:port

# ======================
# Logging & Monitoring
# ======================
LOG_LEVEL=info
# Options: error, warn, info, http, verbose, debug, silly

# Sentry (Optional - for error tracking)
# SENTRY_DSN=your_sentry_dsn_here

# ======================
# Rate Limiting
# ======================
RATE_LIMIT_WINDOW_MS=900000
# 15 minutes in milliseconds
RATE_LIMIT_MAX_REQUESTS=100
# Max requests per window

# ======================
# File Upload Limits
# ======================
MAX_FILE_SIZE=5242880
# 5MB in bytes

# ======================
# Session Configuration
# ======================
SESSION_SECRET=your-session-secret-change-this
SESSION_MAX_AGE=86400000
# 24 hours in milliseconds

# ======================
# Feature Flags
# ======================
ENABLE_EMAIL_VERIFICATION=true
ENABLE_2FA=false
ENABLE_WALI_SUPERVISION=true
MAINTENANCE_MODE=false

# ======================
# Subscription Pricing (in cents)
# ======================
BASIC_PLAN_MONTHLY=999
# $9.99/month
PREMIUM_PLAN_MONTHLY=2300
# $23.00/month
VIP_PLAN_MONTHLY=4900
# $49.00/month

# Annual discounts (percentage)
ANNUAL_DISCOUNT=20
# 20% off annual subscriptions

# ======================
# Free Tier Limits
# ======================
FREE_PROFILE_VIEWS_PER_MONTH=10
FREE_LIKES_PER_DAY=5
FREE_SUPER_LIKES_PER_MONTH=1

# ======================
# Premium Features
# ======================
PREMIUM_PROFILE_BOOST_DURATION=30
# Duration in minutes
PREMIUM_SUPER_LIKES_PER_MONTH=5
PREMIUM_PROFILE_BOOSTS_PER_MONTH=1

# ======================
# Admin Configuration
# ======================
ADMIN_EMAIL=admin@islamicdating.com
ADMIN_NOTIFICATION_EMAIL=notifications@islamicdating.com

# ======================
# Compliance & Legal
# ======================
COMPANY_NAME=Islamic Dating Inc.
COMPANY_ADDRESS=Your Company Address
COMPANY_COUNTRY=Singapore
PRIVACY_POLICY_URL=https://yourapp.com/privacy
TERMS_OF_SERVICE_URL=https://yourapp.com/terms

# ======================
# Analytics (Optional)
# ======================
# GOOGLE_ANALYTICS_ID=UA-XXXXX-Y
# FACEBOOK_PIXEL_ID=your_pixel_id

# ======================
# AWS S3 (Alternative to Cloudinary)
# ======================
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your-bucket-name

# ======================
# Development & Testing
# ======================
# Test database for automated tests
TEST_MONGO_URI=mongodb://localhost:27017/islamic-dating-app-test

# Disable rate limiting in development
DISABLE_RATE_LIMIT=true

# Enable debug logging
DEBUG=app:*

# ======================
# Production-Only Settings
# ======================
# Set these only in production environment

# SSL/TLS
# FORCE_HTTPS=true

# CORS allowed origins (comma-separated)
# CORS_ORIGINS=https://yourapp.com,https://www.yourapp.com

# Cookie settings
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=strict

# Trust proxy (for deployment behind reverse proxy)
# TRUST_PROXY=true

# ======================
# Backup & Maintenance
# ======================
# Database backup schedule (cron format)
# BACKUP_SCHEDULE=0 2 * * *
# Daily at 2 AM

# Backup retention days
# BACKUP_RETENTION_DAYS=30

# ======================
# Notes
# ======================
# 1. Never commit the actual .env file to version control
# 2. Keep .env.example updated when adding new variables
# 3. Use strong, unique secrets in production
# 4. Rotate secrets periodically
# 5. Use environment-specific values (dev, staging, production)
# 6. Store production secrets in secure vault (AWS Secrets Manager, etc.)
